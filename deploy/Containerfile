# birdsynth: the static Vite build (dist/) served by unprivileged nginx on
# 8080, and the link service (dist-server/relay.cjs, bundled from server/)
# beside it on 127.0.0.1:8002, which nginx forwards /sync to. Build from the
# repo root after `npm run build` (it makes both):
#   docker build -f deploy/Containerfile .
FROM nginxinc/nginx-unprivileged:stable-alpine

LABEL org.opencontainers.image.title="birdsynth" \
      org.opencontainers.image.description="A wavetable synthesizer in the browser (Rust/WebAssembly engine, Svelte UI) with an explainer layer, and its link service" \
      org.opencontainers.image.source="https://github.com/davenull/birdsynth" \
      org.opencontainers.image.url="https://birdsynth.abusing.technology" \
      org.opencontainers.image.licenses="BSD-3-Clause"

USER root
RUN apk add --no-cache nodejs
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
# the image's entrypoint runs this before nginx starts
COPY --chmod=755 deploy/40-link-service.sh /docker-entrypoint.d/40-link-service.sh
COPY dist-server/relay.cjs /opt/birdsynth/relay.cjs
COPY dist/ /usr/share/nginx/html/
USER 101

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/ && wget -q -O /dev/null http://127.0.0.1:8080/sync/health || exit 1
